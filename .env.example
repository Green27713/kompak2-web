# ──────────────────────────────────────────────────────────────────────────────
# PixSnug — Environment Variables
# Copy this file to .env.local and fill in every value before running the app.
# Never commit .env.local — it is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (SQLite — single file on disk, zero extra infrastructure) ─────────
# Path is relative to the project root. The file is created automatically on
# first run. Change to an absolute path on the server (e.g. /root/pixsnug/...).
DATABASE_URL="file:./prisma/pixsnug.db"

# ── Redis (local instance on the DigitalOcean droplet) ────────────────────────
# Used for sliding-window rate limiting. Already running via apt/snap.
REDIS_URL=redis://localhost:6379

# ── iron-session cookie encryption ────────────────────────────────────────────
# Must be AT LEAST 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# To rotate: change to a JSON object {"1":"old","2":"new"} — iron-session
# decrypts with all keys but only encrypts with the highest-numbered one.
SESSION_PASSWORD="replace-me-with-a-32-char-secret-minimum"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use TEST keys (sk_test_...) until you are ready to go live.
# Found in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Found in: Stripe Dashboard → Developers → Webhooks → (your endpoint) → Signing secret
# Register the webhook endpoint as: https://pixsnug.com/api/stripe/webhook
# Events to subscribe: checkout.session.completed, customer.subscription.updated,
#                      customer.subscription.deleted
# For local testing use the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — run the setup script to create the Pro product automatically:
#   node scripts/create-stripe-product.mjs
# It will print the STRIPE_PRICE_ID_PRO value to copy here.
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# ── Resend (transactional email) ───────────────────────────────────────────────
# Found in: resend.com → API Keys
# Used by: /api/waitlist/enterprise (confirmation emails)
#          /api/stripe/webhook (admin notification on new Pro signups)
RESEND_API_KEY=re_...

# ── Email addresses ────────────────────────────────────────────────────────────
# Admin receives a notification on every new Pro signup and Enterprise waitlist entry.
ADMIN_EMAIL=markgreenslade@pixsnug.com
# Shown in the footer mailto: link and Privacy/Terms pages.
PRIVACY_EMAIL=privacy@pixsnug.com

# ── Smart Compress (optional) ─────────────────────────────────────────────────
# Set to true to enable per-image content analysis and adaptive JPEG settings.
# Only applies to JPEG output; PNG/WebP paths are unaffected. Adds ~30ms/image.
SMART_COMPRESS=false

# ── Public app URL (no trailing slash) ────────────────────────────────────────
# Used by Stripe to build success_url and cancel_url for Checkout Sessions.
NEXT_PUBLIC_BASE_URL=https://pixsnug.com
